# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Option 1 (Local MongoDB): mongodb://localhost:27017/auth_api
# Option 2 (MongoDB Atlas): mongodb+srv://<db_user>:<db_password>@<cluster-url>/auth_api?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/auth_api

# JWT Configuration
JWT_ACCESS_SECRET=your_jwt_access_secret_key_min_32_characters_here
ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_min_32_characters_here
REFRESH_TOKEN_EXPIRES_IN=7d

# SMTP / Email Configuration (Gmail App Password or SMTP provider)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
EMAIL_FROM="Auth API" <noreply@example.com>

# Client URL (for CORS whitelist)
CLIENT_URL=http://localhost:3000

# Verification & Reset URLs
EMAIL_VERIFICATION_URL=http://localhost:5000/api/auth/verify-email
PASSWORD_RESET_URL=http://localhost:5000/api/auth/reset-password