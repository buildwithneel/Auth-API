# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Safe Placeholders)
# Option 1 (Local MongoDB): mongodb://localhost:27017/auth_db_placeholder
# Option 2 (MongoDB Atlas): mongodb+srv://<db_user>:<db_password>@<cluster-url>/auth_db_placeholder?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/auth_db_placeholder

# JWT Configuration (Placeholders - replace with secure random secrets in .env)
JWT_SECRET=your_jwt_secret_key_placeholder
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your_jwt_refresh_secret_placeholder
JWT_REFRESH_EXPIRES_IN=7d

# Email / SMTP Configuration (Placeholders)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username_placeholder
SMTP_PASS=your_smtp_password_placeholder
EMAIL_FROM=noreply@example.com

# Client / CORS Configuration
CLIENT_URL=http://localhost:3000

#email service
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_16_character_app_password

#Verification URl
EMAIL_VERIFICATION_URL=http://localhost:5000/api/auth/verify-email